# ===========================================
# Variables de entorno – LuckyLY / WEB.SORTEOS
# Copia este archivo a .env.local y rellena los valores.
# ===========================================

# --- OBLIGATORIAS (sin ellas fallan login y BD) ---
# Base de datos: Neon (Postgres Serverless), Postgres 17
# Obtén la URL en el dashboard de Neon (Connection string). Ejemplo:
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://usuario:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Generar uno nuevo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=minimo_32_caracteres_aleatorios

# --- OPCIONALES: Subida de imágenes (admin página principal) ---
# Si no las defines, la subida de imágenes del carrusel fallará.
# En Vercel: crear token en Storage → Blob.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxx

# --- OPCIONALES: Email (verificación, recuperación de contraseña) ---
# Si no las defines, en desarrollo solo se loguea el email; en producción no se envían.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu_email@gmail.com
# SMTP_PASS=contraseña_de_aplicacion

# --- OPCIONALES: URL base de la app (emails, PDFs, enlaces) ---
# NEXT_PUBLIC_APP_URL=http://localhost:3000
# En Vercel suele usarse VERCEL_URL automáticamente.

# --- OPCIONALES: Producción / primer administrador MASTER ---
# MASTER_SETUP_SECRET=secreto_para_crear_master_en_produccion
# Si defines MASTER_INITIAL_EMAIL y MASTER_INITIAL_PASSWORD, el script apply-schema-neon.js / create-master
# y el endpoint /api/setup/create-master pueden crear/actualizar ese usuario MASTER (sin credenciales en código).
# MASTER_INITIAL_EMAIL=admin@tudominio.com
# MASTER_INITIAL_PASSWORD=contraseña_inicial_segura
# MASTER_INITIAL_NAME=Administrador Master
# MASTER_INITIAL_DOCUMENT_ID=V-00000001
# No pongas NODE_ENV en .env.local: en local next dev usa "development"; en Vercel se configura en el dashboard

