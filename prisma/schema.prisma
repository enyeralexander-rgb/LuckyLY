generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      String                   @id @default(cuid())
  email                   String                   @unique
  passwordHash            String
  name                    String
  username                String?                  @unique
  avatarUrl               String?
  documentId              String                   @unique
  phoneNumber             String?
  nationalId              String?
  nationalIdType          String? // "V" para Venezolano, "E" para Extranjero
  bank                    Bank?
  bankPhone               String?
  suspended               Boolean                  @default(false)
  emailVerified           Boolean                  @default(false)
  emailVerifiedAt         DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  role                    Role                     @default(USER)
  createdById             String?
  createdBy               User?                    @relation("UserCreator", fields: [createdById], references: [id])
  createdUsers            User[]                   @relation("UserCreator")
  auditLogs               AuditLog[]
  prizeClaims             PrizeClaim[]
  createdRaffles          Raffle[]                 @relation("UserRaffles")
  tickets                 Ticket[]
  notifications           Notification[]
  updatedTerms            TermsAndConditions[]     @relation("TermsUpdater")
  updatedRules            Rules[]                  @relation("RulesUpdater")
  updatedPaymentMobile    PaymentMobile[]          @relation("PaymentMobileUpdater")
  updatedSocialMedia      SocialMedia[]            @relation("SocialMediaUpdater")
  createdReferralLinks    ReferralLink[]           @relation("ReferralLinkCreator")
  referralVisits          ReferralVisit[]          @relation("ReferralUser")
  favoriteRaffles         FavoriteRaffle[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  twoFactorAuth           TwoFactorAuth?
  automationRules         AutomationRule[]

  @@index([role])
  @@index([username])
  @@index([documentId])
  @@index([suspended])
  @@index([emailVerified])
}

model Raffle {
  id              String           @id @default(cuid())
  title           String
  description     String?
  type            DrawType
  pricePerSlot    Decimal          @db.Decimal(10, 2)
  slots           Int
  winnersCount    Int              @default(1)
  mirrorMode      Boolean          @default(false)
  status          String           @default("ACTIVE")
  startsAt        DateTime?
  closesAt        DateTime?
  executedAt      DateTime?
  winningItem     String?
  prizes          Json? // Array de premios
  templateId      String? // ID de plantilla usada
  autoExecute     Boolean          @default(false) // Auto-ejecutar cuando todos los cupos estén confirmados
  createdById     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdBy       User?            @relation("UserRaffles", fields: [createdById], references: [id])
  tickets         Ticket[]
  ticketItems     TicketItem[]     @relation("RaffleTicketItems")
  favoriteRaffles FavoriteRaffle[]
  raffleTemplates RaffleTemplate[] @relation("TemplateRaffles")

  @@index([status, closesAt])
  @@index([templateId])
  @@index([autoExecute])
}

model Ticket {
  id               String         @id @default(cuid())
  raffleId         String
  userId           String
  items            Json
  totalPaid        Decimal        @db.Decimal(10, 2)
  purchasedAt      DateTime       @default(now())
  status           String         @default("PENDING")
  paymentMethod    PaymentMethod?
  paymentMobileRef String?
  ticketItems      TicketItem[]
  prizeClaim       PrizeClaim?
  raffle           Raffle         @relation(fields: [raffleId], references: [id])
  user             User           @relation(fields: [userId], references: [id])

  @@index([raffleId])
  @@index([userId, purchasedAt])
  @@index([status])
}

model PrizeClaim {
  id            String      @id @default(cuid())
  ticketId      String      @unique
  userId        String
  status        PrizeStatus @default(REQUESTED)
  paymentRef    String?
  paymentProof  String? // URL o path del comprobante de pago
  processedAt   DateTime?
  processedById String?
  createdAt     DateTime    @default(now())
  ticket        Ticket      @relation(fields: [ticketId], references: [id])
  user          User        @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model TicketItem {
  id       String           @id @default(cuid())
  raffleId String
  ticketId String
  value    String
  status   TicketItemStatus @default(PENDING)
  ticket   Ticket           @relation(fields: [ticketId], references: [id])
  raffle   Raffle           @relation("RaffleTicketItems", fields: [raffleId], references: [id])

  @@unique([raffleId, value])
  @@index([ticketId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole Role?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  ip        String?
  createdAt DateTime @default(now())
  actor     User?    @relation(fields: [actorId], references: [id])

  @@index([actorId, createdAt])
  @@index([createdAt])
}

model TermsAndConditions {
  id          String   @id @default(cuid())
  content     String   @db.Text
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("TermsUpdater", fields: [updatedById], references: [id])
}

model Rules {
  id          String   @id @default(cuid())
  content     String   @db.Text
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("RulesUpdater", fields: [updatedById], references: [id])
}

model PaymentMobile {
  id          String   @id @default(cuid())
  imageUrl    String
  cedula      String?
  telefono    String?
  destino     String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("PaymentMobileUpdater", fields: [updatedById], references: [id])
}

model SocialMedia {
  id          String   @id @default(cuid())
  facebook    String?
  instagram   String?
  twitter     String?
  youtube     String?
  tiktok      String?
  whatsapp    String?
  updatedAt   DateTime @updatedAt
  updatedById String?
  updatedBy   User?    @relation("SocialMediaUpdater", fields: [updatedById], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json? // Datos adicionales (ticketId, raffleId, etc.)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  readAt    DateTime?
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
}

model ReferralLink {
  id            String          @id @default(cuid())
  code          String          @unique
  name          String
  createdById   String
  createdBy     User            @relation("ReferralLinkCreator", fields: [createdById], references: [id])
  clicks        Int             @default(0)
  registrations Int             @default(0)
  purchases     Int             @default(0)
  revenue       Decimal         @default(0) @db.Decimal(10, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  visits        ReferralVisit[]

  @@index([createdById])
  @@index([code])
}

model ReferralVisit {
  id             String       @id @default(cuid())
  referralLinkId String
  referralLink   ReferralLink @relation(fields: [referralLinkId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?        @relation("ReferralUser", fields: [userId], references: [id])
  ip             String?
  userAgent      String?
  country        String?      // País obtenido por geolocalización
  registered     Boolean      @default(false)
  purchased      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([referralLinkId, createdAt])
  @@index([userId])
  @@index([country])
}

enum Role {
  USER
  AGENT
  CONTABLE
  SUPERADMIN
  MASTER
}

enum DrawType {
  NUMBERS
  ANIMALS
  STATES
  FLAGS
  ZODIAC
}

enum PrizeStatus {
  REQUESTED
  PROCESSING
  PAID
  REJECTED
  INCORRECT_DATA
}

enum Bank {
  BANESCO
  VENEZUELA
  MERCANTIL
  BOD
  PROVINCIAL
  BICENTENARIO
  OTRA
}

enum PaymentMethod {
  BANESCO
  BINANCE
  MOBILE
}

enum TicketItemStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum NotificationType {
  TICKET_PURCHASED
  TICKET_CONFIRMED
  RAFFLE_WON
  PRIZE_CLAIMED
  PRIZE_PAID
  ACCOUNT_UPDATED
  SYSTEM
  RAFFLE_CLOSING_SOON
  FAVORITE_RAFFLE_UPDATED
}

model FavoriteRaffle {
  id        String   @id @default(cuid())
  userId    String
  raffleId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle    Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([userId, raffleId])
  @@index([userId])
  @@index([raffleId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, used])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, used])
  @@index([expiresAt])
}

model TwoFactorAuth {
  id          String   @id @default(cuid())
  userId      String   @unique
  secret      String
  enabled     Boolean  @default(false)
  backupCodes String[] // Array de códigos de respaldo
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RaffleTemplate {
  id           String   @id @default(cuid())
  name         String
  description  String?
  type         DrawType
  pricePerSlot Decimal  @db.Decimal(10, 2)
  slots        Int
  winnersCount Int      @default(1)
  mirrorMode   Boolean  @default(false)
  prizes       Json? // Array de premios
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  raffles      Raffle[] @relation("TemplateRaffles")

  @@index([createdById])
}

model AutomationRule {
  id          String         @id @default(cuid())
  name        String
  type        AutomationType
  enabled     Boolean        @default(true)
  config      Json // Configuración específica del tipo de automatización
  createdById String
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [createdById], references: [id])

  @@index([enabled])
  @@index([type])
}

enum AutomationType {
  AUTO_EXECUTE_RAFFLE
  SEND_REMINDER_24H
  SEND_REMINDER_LOW_SLOTS
  AUTO_EXPORT_REPORTS
}

model HomePageConfig {
  id                    String   @id @default(cuid())
  
  // Hero Section
  heroImages            Json?    // Array de URLs de imágenes del hero (máx 5)
  heroTitle             String?
  heroSubtitle          String?
  heroEffect            String?  // "fade", "slide", "parallax", "fade-in-reveal", "zoom-in-out", "horizontal-scroll", "text-animation", "carousel", "none"
  heroEffectParams      Json?    // Parámetros específicos de cada efecto
  heroAutoSlide         Boolean  @default(false)
  heroAutoSlideMode     String?  // "none", "linear", "reverse", "fade", "zoom", "slide-up", "slide-down"
  heroAutoSlideInterval Int      @default(5000)
  heroScrollFade        Boolean  @default(true)
  heroOpacity           Float    @default(0.8)
  heroBlur              Float    @default(4.0)
  heroTextColor         String?  // Color del texto del título
  heroSubtitleColor     String?  // Color del texto del subtítulo
  heroOverlayColor      String?  // Color del overlay oscuro
  heroOverlayOpacity    Float    @default(0.7)
  heroImageSize         String?  // "cover" | "contain" - Tamaño de la imagen
  
  // Video Instagram
  instagramVideoUrl     String?
  
  // Header
  headerConfig          Json?    // Configuración del header
  
  // Contacto
  contactConfig         Json?    // Configuración de contacto
  
  // Footer
  footerConfig          Json?    // Configuración del footer
  
  // Orden y Visibilidad
  sectionOrder          Json?    // Array con orden de todas las secciones
  sectionVisibility     Json?    // Objeto con visibilidad de cada sección
  
  updatedById           String?
  updatedAt             DateTime @updatedAt
  createdAt             DateTime @default(now())

  @@index([updatedById])
}
