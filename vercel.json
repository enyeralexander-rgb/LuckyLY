{
  "buildCommand": "prisma generate && node scripts/apply-schema-postgres.js && npm run build && npm run postbuild",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*.ts": {
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "headers": [
    {
      "source": "/((?!_next/static|_next/image|api|favicon.ico).*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
