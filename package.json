{
  "name": "web-sorteos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules/.cache",
    "clean:deep": "rm -rf .next node_modules/.cache .next/cache .swc",
    "clean:full": "rm -rf .next node_modules/.cache node_modules/.next .swc tsconfig.tsbuildinfo",
    "clean:webpack": "rm -rf .next/cache/webpack .next/server/webpack-runtime.js .next/static/webpack",
    "clean:build": "npm run stop && npm run clean:deep && npm run build",
    "dev:clean": "npm run stop && npm run clean:deep && npm run prisma:generate && npm run dev",
    "dev:safe": "npm run stop && npm run clean:webpack && npm run dev",
    "stop": "pkill -f 'next dev' || pkill -f 'next-server' || true",
    "verify": "npm run stop && npm run clean:deep && npm run build && echo '✓ Verificación completada sin errores'",
    "verify:types": "npx tsc --noEmit && echo '✓ Verificación de tipos completada sin errores'",
    "fix:webpack": "npm run stop && npm run clean:webpack && npm run clean:deep && echo '✅ Caché de webpack limpiada. Ejecuta: npm run dev'",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed"
  },
  "prisma": {
    "seed": "node --loader ts-node/esm prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "2.4.2",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.16.12",
    "@types/nodemailer": "^6.4.21",
    "@types/qrcode": "^1.5.6",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "bcryptjs": "2.4.3",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.5",
    "exceljs": "^4.4.0",
    "jose": "^5.2.3",
    "jsonwebtoken": "9.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.7",
    "next": "14.2.5",
    "next-auth": "4.24.7",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pg": "^8.16.3",
    "prisma": "^5.22.0",
    "qrcode": "^1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "recharts": "^3.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "zod": "3.23.8"
  },
  "devDependencies": {}
}
