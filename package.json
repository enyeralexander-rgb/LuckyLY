{
  "name": "web-sorteos",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-push-neon.js && next build",
    "start": "next start",
    "lint": "next lint",
    "clean": "rm -rf .next node_modules/.cache",
    "clean:deep": "rm -rf .next node_modules/.cache .swc",
    "clean:full": "rm -rf .next node_modules/.cache node_modules/.next .swc tsconfig.tsbuildinfo",
    "clean:webpack": "rm -rf .next/cache/webpack .next/server/webpack-runtime.js .next/static/webpack",
    "clean:build": "npm run stop && sleep 2 && npm run clean:deep && npm run build",
    "dev:clean": "npm run stop && sleep 2 && npm run clean:deep && npm run dev",
    "dev:safe": "npm run stop && npm run clean:webpack && npm run dev",
    "stop": "pkill -f 'next dev' || pkill -f 'next-server' || true",
    "verify": "npm run stop && npm run clean:deep && npm run build && echo '✓ Verificación completada sin errores'",
    "verify:types": "npx tsc --noEmit && echo '✓ Verificación de tipos completada sin errores'",
    "fix:webpack": "npm run stop && npm run clean:webpack && npm run clean:deep && echo '✅ Caché de webpack limpiada. Ejecuta: npm run dev'",
    "db:verify": "node scripts/verify-connection.js",
    "db:setup": "node scripts/apply-schema-neon.js",
    "db:push": "node scripts/db-push-neon.js",
    "db:seed": "npx tsx scripts/seed-neon.ts",
    "db:create-master": "npx tsx scripts/create-master-vercel.ts",
    "check-env": "node scripts/check-env.js"
  },
  "ts-node": {
    "esm": true,
    "compilerOptions": {
      "module": "ESNext"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@paralleldrive/cuid2": "^2.2.2",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/bcryptjs": "2.4.2",
    "@types/jsonwebtoken": "9.0.6",
    "@types/node": "20.16.12",
    "@types/nodemailer": "^6.4.21",
    "@types/pg": "^8.16.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/blob": "^2.2.0",
    "autoprefixer": "^10.4.23",
    "bcryptjs": "2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "eslint-config-next": "^15.0.0",
    "exceljs": "^4.4.0",
    "jose": "^5.2.3",
    "jsonwebtoken": "9.0.2",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.562.0",
    "next": "^15.0.0",
    "next-auth": "4.24.13",
    "next-themes": "^0.4.6",
    "nodemailer": "^7.0.7",
    "otplib": "^13.3.0",
    "pg": "^8.17.1",
    "postcss": "^8.5.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.6.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "swr": "^2.4.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "ts-node": "^10.9.2",
    "typescript": "5.6.3",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0"
  }
}
